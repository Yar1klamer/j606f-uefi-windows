+#ifdef J606F_RAMOOPS_LOG
+// uefi-winarm (J606F): mirror the log into the console zone of the pmOS ramoops region (0xFFC00000, 1 MiB: 640 KiB dmesg records,
+// then 256 KiB console). After a warm reset pmOS shows it as /sys/fs/pstore/console-ramoops-0. The zone has ECC 16 (RS over 128-byte
